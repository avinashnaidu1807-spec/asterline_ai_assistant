# Asterline AI Research Assistant Environment Configuration
# Core functionality runs 100% locally with zero paid services required.

# LLM Provider: "openai", "ollama", or "mock" (default: mock - works out-of-the-box offline)
LLM_PROVIDER=mock

# OpenAI API Key (optional - only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Local LLM (optional - only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# LangSmith Observability & Tracing (optional)
# Set your API key below and LANGCHAIN_TRACING_V2=true to enable LangSmith tracing.
# As required by the assignment, share your LangSmith project with: radialpulse@nxtwave.co.in
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asterline-research-assistant
LANGCHAIN_TRACING_V2=false

# Local Embeddings (Runs locally via ONNX Runtime - no PyTorch/GPU/API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
DATABASE_URL=sqlite:///./data/asterline.db
CORPUS_PATH=./data/corpus.jsonl

# Retrieval Parameters
TOP_K_RETRIEVAL=5
MAX_RETRIES=3

# Application Settings
DEBUG=false
APP_TITLE=Asterline Research Assistant
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

