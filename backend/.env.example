# LLM Provider: "openai", "ollama", or "mock" (default: mock - works without any API key)
LLM_PROVIDER=mock

# OpenAI (optional - only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (optional - only needed if LLM_PROVIDER=ollama, requires Ollama running locally)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# LangSmith (optional - for observability traces)
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_PROJECT=asterline-research-assistant

# Embeddings (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage
CHROMA_PERSIST_DIR=./data/chroma_db
DATABASE_URL=sqlite+aiosqlite:///./data/asterline.db
CORPUS_PATH=../data/corpus.jsonl

# App Settings
DEBUG=false
TOP_K_RETRIEVAL=5
